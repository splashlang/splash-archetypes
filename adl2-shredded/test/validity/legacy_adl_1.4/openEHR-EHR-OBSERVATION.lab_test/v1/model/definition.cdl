	OBSERVATION[id1] matches {	-- Laboratory test
		data matches {
			HISTORY[id2] matches {
				events cardinality matches {1..*; unordered} matches {
					EVENT[id3] matches {	-- Any event
						data matches {
							ITEM_TREE[id4] matches {
								items matches {
									ELEMENT[id6] occurrences matches {0..1} matches {	-- Test name
										value matches {
											DV_TEXT[id7] 
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

