	CLUSTER[id1] occurrences matches {0..1} matches {	-- Person additional demographic data
		items matches {
			ELEMENT[id2] occurrences matches {0..*} matches {	-- Sex
				value matches {
					DV_CODED_TEXT[id5] matches {
						defining_code matches {[ac1]}		-- Sex (synthesised)
					}
				}
			}
			ELEMENT[id3] occurrences matches {0..*} matches {	-- Mother's family name
				value matches {
					DV_TEXT[id6] 
				}
			}
			ELEMENT[id4] occurrences matches {0..*} matches {	-- Identification comment
				value matches {
					DV_TEXT[id7] 
				}
			}
		}
	}

