	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Illustrate constraining of fields whose types in the RM are a generic type parameter, i.e. typically 'T', 'U' etc. In this example, the upper and lower fields are of type 'T' in the RM definition of DV_INTERVAL.">
			use = <"Regression testing">
			keywords = <"ADL", "test", "generic types">
		>
	>

definition
	CLUSTER[id1] occurrences matches {0..*} matches {
		items existence matches {1} cardinality matches {0..*; ordered} matches {
			ELEMENT[id2] occurrences matches {0..1} matches {
				value existence matches {0..1} matches {
					DV_INTERVAL<DV_DATE_TIME>[id3] occurrences matches {0..1} matches {
						upper existence matches {0..1} matches {
							DV_DATE_TIME[id4] occurrences matches {0..1} 
						}
						lower existence matches {0..1} matches {
							DV_DATE_TIME[id5] occurrences matches {0..1} 
						}
					}
				}
			}
		}
	}

