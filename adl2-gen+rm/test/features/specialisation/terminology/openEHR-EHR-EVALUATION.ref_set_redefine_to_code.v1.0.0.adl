definition
	EVALUATION[id1.1] occurrences matches {0..*} matches {
		data existence matches {1} matches {
			ITEM_TREE[id2] occurrences matches {0..1} matches {
				items existence matches {0..1} cardinality matches {1..*; unordered} matches {
					ELEMENT[id3] occurrences matches {1..*} matches {
						value existence matches {0..1} matches {
							DV_CODED_TEXT[id4] occurrences matches {0..1} matches {
								defining_code existence matches {1} matches {[ac1.1]}
							}
						}
					}
				}
			}
		}
	}

