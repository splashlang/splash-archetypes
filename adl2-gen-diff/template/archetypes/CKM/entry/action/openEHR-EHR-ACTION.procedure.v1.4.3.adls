terminology
	term_definitions = <
		["de"] = <
			["id1"] = <
				text = <"Prozedur">
				description = <"Eine klinische Aktivität, die zur Früherkennung, Untersuchung, Diagnose, Heilung, Therapie, Bewertung oder in Hinsicht auf palliative Maßnahmen durchgeführt wird.">
			>
			["id3"] = <
				text = <"Name der Prozedur">
				description = <"Identifizierung der Prozedur über den Namen.">
			>
			["id4"] = <
				text = <"Details zur Prozedur">
				description = <"Strukturierte Informationen über die Prozedur.">
			>
			["id5"] = <
				text = <"Geplante Prozedur">
				description = <"Die Prozedur, die durchgeführt werden soll, ist geplant.">
			>
			["id6"] = <
				text = <"Kommentar">
				description = <"Zusätzliche Beschreibung der Aktivität oder der \"Pathway\"-Verlaufsschritte, die in anderen Bereichen nicht erfasst wurden.">
			>
			["id7"] = <
				text = <"Komplikationen">
				description = <"Details zu allen Komplikationen, die sich aus der Prozedur ergeben haben.">
			>
			["id8"] = <
				text = <"Auftrag für Prozedur versendet">
				description = <"Der Auftrag für die Prozedur wurde versendet.">
			>
			["id15"] = <
				text = <"Grund">
				description = <"Grund, warum die angegebene Aktivität für diese Prozedur durchgeführt wurde.">
			>
			["id35"] = <
