definition
	OBSERVATION[id1.1] matches {
		data matches {
			HISTORY[id9] matches {
				events cardinality matches {2..*; unordered} matches {
					EVENT[id3.1] occurrences matches {0..1} matches {
						data matches {
							ITEM_TREE[id10] matches {
								items cardinality matches {2..*; ordered} matches {
									ELEMENT[id4] matches {
										value matches {
											DV_TEXT[id11] 
										}
									}
									ELEMENT[id5] matches {
										value matches {
											DV_BOOLEAN[id12] 
										}
									}
									ELEMENT[id6] matches {
										value matches {
											DV_QUANTITY[id13] 
										}
									}
									ELEMENT[id7] matches {
										value matches {
											DV_MULTIMEDIA[id14] 
										}
									}
									ELEMENT[id8] 
								}
							}
						}
					}
				}
			}
		}
		protocol existence matches {1} 
	}

