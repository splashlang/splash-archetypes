definition
	OBSERVATION[id1.1] matches {
		data matches {
			HISTORY[id2] matches {
				events cardinality matches {1..*; unordered} matches {
					EVENT[id3] occurrences matches {0..1} matches {
						data matches {
							ITEM_TREE[id4] matches {
								items matches {
									ELEMENT[id5] occurrences matches {0..1} matches {
										value matches {
											DV_CODED_TEXT[id20.1] matches {
												defining_code matches {[at0.2]}
											}
										}
									}
									CLUSTER[id11] occurrences matches {0..1} matches {
										items matches {
											ELEMENT[id12] occurrences matches {0..1} matches {
												value matches {
													DV_CODED_TEXT[id21.1] matches {
														defining_code matches {[ac0.1]}
													}
												}
											}
											ELEMENT[id19] occurrences matches {0..1} matches {
												value matches {
													DV_TEXT[id22] 
												}
											}
											ELEMENT[id6] occurrences matches {0..1} matches {
												value matches {
													DV_CODED_TEXT[id23] matches {
														defining_code matches {[ac1]}
													}
												}
											}
											ELEMENT[id13] occurrences matches {0..*} 
											ELEMENT[id13.1] occurrences matches {0..*} matches {
												value matches {
													DV_QUANTITY[id0.5] matches {
														property matches {[at0.7]}
														units matches {"/h", "/d", "/wk"}
													}
												}
											}
											ELEMENT[id13.2] occurrences matches {0..*} matches {
												value matches {
													DV_QUANTITY[id0.6] matches {
														property matches {[at0.8]}
														units matches {"gm/d", "gm/wk"}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1"] = <
				text = <"Substance Use">
				description = <"Generic archetype to record the actual use or consumption of a defined substance at the present time, a specific time or over a period of time. ">
			>
