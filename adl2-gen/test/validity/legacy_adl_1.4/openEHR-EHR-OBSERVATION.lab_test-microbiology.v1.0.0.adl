definition
	OBSERVATION[id1.1] matches {
		data matches {
			HISTORY[id2] matches {
				events cardinality matches {1..*; unordered} matches {
					EVENT[id3] matches {
						data matches {
							ITEM_TREE[id4] matches {
								items matches {
									ELEMENT[id6] occurrences matches {0..1} matches {
										value matches {
											DV_TEXT[id7] 
										}
									}
									CLUSTER[id0.34] occurrences matches {0..1} matches {
										items matches {
											ELEMENT[id0.36] occurrences matches {0..1} matches {
												value matches {
													DV_QUANTITY[id0.37] 
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1"] = <
				text = <"Laboratory test">
				description = <"To record the result of a laboratory test which may be used to record a single valued test but will often be specialised or templated to represent multiple value or 'panel' tests.  This archetype also acts as the parent for specialisations appropriate for more specific laboratory tests microbiology, histopathology.">
			>
			["id3"] = <
				text = <"Any event">
				description = <"Any event.">
			>
			["id6"] = <
				text = <"Test name">
				description = <"Specific identifier for this lab test. e.g. Full blood count , blood glucose, urine microbiology.  May equate to the result name for a single value result. Commonly a coded term e.g from LOINC or SNOMED-CT.">
			>
			["id0.34"] = <
				text = <"Bodily fluid findings">
				description = <"Findings related to a bodily fluid specimen.">
			>
			["id0.36"] = <
				text = <"Red cell count">
				description = <"Red blood cell count in the bodily fluid..">
			>
			["id1.1"] = <
				text = <"Microbiolology">
				description = <"Generic laboratory test archetype for microbiology testing.">
			>
		>
	>

