							ELEMENT[id3] occurrences matches {0..*} matches {
								value matches {
									DV_CODED_TEXT[id5] matches {
										defining_code matches {[ac3]}
									}
								}
							}
							ELEMENT[id3.1] occurrences matches {0..*} matches {
								value matches {
									DV_CODED_TEXT[id5] matches {
										defining_code matches {[ac3]}
