definition
	PERSON[id1.1] matches {
		details matches {
			ITEM_TREE[id2] occurrences matches {0..1} matches {
				items matches {
					use_archetype CLUSTER[id11.1, openEHR-DEMOGRAPHIC-CLUSTER.t_patient_ds_sf-1.v1.0.0] occurrences matches {0..1} matches {
