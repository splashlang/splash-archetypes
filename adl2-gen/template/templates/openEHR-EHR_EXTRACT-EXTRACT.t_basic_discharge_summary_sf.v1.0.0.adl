template (adl_version=2.3.0; rm_release=1.1.0; generated)
	openEHR-EHR_EXTRACT-EXTRACT.t_basic_discharge_summary_sf.v1.0.0

specialize
	openEHR-EHR_EXTRACT-EXTRACT.discharge_summary.v1

language
	original_language = <[ISO_639-1::en]>

description
	lifecycle_state = <"unmanaged">
	original_author = <
		["name"] = <"Thomas Beale">
		["organisation"] = <"Ocean Informatics">
		["date"] = <"01-04-2011">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Basic discharge summary">
			use = <"test use">
			keywords = <"discharge", "admin">
		>
	>

definition
	EXTRACT[id1.1] matches {
		chapters matches {
			EXTRACT_CHAPTER[id3] matches {
				items matches {
					GENERIC_CONTENT_ITEM[id4] occurrences matches {1} matches {
						item matches {
							use_archetype PERSON[id101.1, openEHR-DEMOGRAPHIC-PERSON.t_patient_ds_sf.v1] 
							allow_archetype PERSON[id101] closed 
						}
					}
					GENERIC_CONTENT_ITEM[id5] occurrences matches {1} matches {
						item matches {
							use_archetype ORGANISATION[id102.1, openEHR-DEMOGRAPHIC-ORGANISATION.healthcare_establishment.v1] 
							allow_archetype ORGANISATION[id102] closed 
						}
					}
					GENERIC_CONTENT_ITEM[id6] occurrences matches {1..*} matches {
						item matches {
							use_archetype PERSON[id103.1, openEHR-DEMOGRAPHIC-PERSON.healthcare_professional.v1] 
							allow_archetype PERSON[id103] closed 
						}
					}
				}
			}
			EXTRACT_CHAPTER[id2] matches {
				items matches {
					GENERIC_CONTENT_ITEM[id7.1] occurrences matches {1} matches {
						item matches {
							use_archetype COMPOSITION[id104.1, openEHR-EHR-COMPOSITION.t_clinical_info_ds_sf.v1] 
							allow_archetype COMPOSITION[id104] closed 
						}
						version_set_id existence matches {1} 
						item_status existence matches {1} 
						item_type existence matches {1} 
						item_type_version existence matches {1} 
						creation_time existence matches {1} 
						author existence matches {1} 
					}
				}
			}
		}
	}

terminology
	term_definitions = <
