			>
			["id16"] = <
				text = <"Agent">
				description = <"Agent or other factor known to have caused this problem.">
			>
			["id17"] = <
				text = <"Complication of">
				description = <"Identification of a problem, injury or condition as text,coded text or link within the EHR.">
			>
			["id18"] = <
